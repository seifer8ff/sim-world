{
  "name": "sim-world",
  "version": "0.0.1",
  "description": "Colony Management in a living world.",
  "main": "app.js",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "build:assets": "assetpack -c .assetpack/.assetpack.js",
    "watch": "webpack --watch --config webpack.dev.js",
    "serve": "http-server ./ --port=8085 -c-1",
    "serve:prod": "cd dist && http-server ./ --port=8085 -c-1",
    "dev": "concurrently npm:watch npm:serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seifer8ff/sim-world.git"
  },
